<!--
  放到「有测试的」那个模块的 pom.xml 里（通常是 api 模块，或单独的 test 模块）。
  版本号请替换成你们仓库里实际可用的版本，不要照抄 1.3.0。
-->
<dependency>
    <groupId>com.tngtech.archunit</groupId>
    <artifactId>archunit-junit5</artifactId>
    <version>1.3.0</version>
    <scope>test</scope>
</dependency>

<!--
  同时确认 surefire 至少是 2.22.2，否则 JUnit5 的 @ArchTest 不会被执行：

  <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-surefire-plugin</artifactId>
      <version>3.2.5</version>
  </plugin>

  验证是否生效（应该看到 4 个测试，而不是 0 个）：
      mvn -q test -Dtest=ConventionRules
-->
